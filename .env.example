# Required. Google Maps sourcing.
SERPAPI_API_KEY=

# Required. Qualification and email drafting.
ANTHROPIC_API_KEY=

# Optional. Overrides the model used for both. Defaults to claude-opus-5.
ANTHROPIC_MODEL=

# Optional. Raises the Jina Reader rate limit when reading practice websites.
# Without it the free tier is used, which is slower under load.
JINA_API_KEY=

# Optional. Only needed if ANTHROPIC_API_KEY is an org-level key rather than one
# scoped to a workspace. Sent as the anthropic-workspace-id header.
ANTHROPIC_WORKSPACE_ID=
